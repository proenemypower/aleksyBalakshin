BANKNOTES = [5000, 2000, 1000, 500, 200, 100]

#Запрос суммы у пользователя
amount = int(input("Введите сумму для снятия (целое число, кратное 100): "))

#Проверяем корректность ввода (сумма должна делиться на 100 без остатка и быть больше нуля)
if amount <= 0 or amount % 100 != 0:
    print("Ошибка: банкомат может выдать только сумму, кратную 100 руб.")
else:
    print(f"\nОтчет о выдаче суммы {amount} руб.:")
    print("-" * 30)

    #Перебираем номиналы по «жадному» алгоритму
    for note in BANKNOTES:
        #Находим количество купюр текущего номинала (целочисленное деление)
        count = amount // note

        #Находим остаток суммы, который нужно распределить по более мелким купюрам
        amount = amount % note

        #Выводим строчку отчета, только если такие купюры требуются для выдачи
        if count > 0:
            print(f"Купюры номиналом {note} руб.: {count} шт.")

    print("-" * 30)
