# Ввод данных в одну строку через пробел и одновременное преобразование в числа с плавающей точкой
weight, height = map(float, input("Введите ваш вес (в кг) и рост (в метрах) через пробел: ").split())

# Расчет Индекса Массы Тела (ИМТ) по формуле
bmi = weight / (height * height)

# Вывод результата, отформатированного до одного знака после запятой (спецификатор .1f)
print(f"Ваш Индекс Массы Тела (ИМТ) составляет: {bmi:.1f}")
