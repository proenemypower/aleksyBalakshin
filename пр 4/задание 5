# Ввод целого числа — исходного количества минут
total_minutes = int(input())

# Нахождение полного количества часов (в одном часе 60 минут)
hours = total_minutes // 60

# Нахождение оставшегося количества минут
remaining_minutes = total_minutes % 60

# Вывод текста в строгом соответствии с требуемым форматом
print(f"{total_minutes} минуты - это {hours} час {remaining_minutes} минут.")
