# Ввод положительного четырёхзначного целого числа
number = int(input())

# Нахождение цифр числа с помощью целочисленной арифметики
thousands = number // 1000          # Получаем цифру тысяч
hundreds = (number // 100) % 10     # Получаем цифру сотен
tens = (number // 10) % 10          # Получаем цифру десятков
units = number % 10                 # Получаем цифру единиц

# Вывод текста в строгом соответствии с примером из условия задачи
print(f"Цифра в позиции тысяч равна {thousands}")
print(f"Цифра в позиции сотен равна {hundreds}")
print(f"Цифра в позиции десятков равна {tens}")
print(f"Цифра в позиции единиц равна {units}")
