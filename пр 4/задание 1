import math

# Ввод вещественного (действительного) числа x
x = float(input("Введите число x: "))

# Нахождение пола числа (округление вниз)
floor_x = math.floor(x)

# Нахождение потолка числа (округление вверх)
ceil_x = math.ceil(x)

# Вычисление значения выражения ⌊x⌋ + ⌈x⌉
result = floor_x + ceil_x

# Вывод одного числа — результата вычисления
print(result)
