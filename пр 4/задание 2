import math

# Ввод координат четырех действительных чисел, каждого на отдельной строке
x1 = float(input())
y1 = float(input())
x2 = float(input())
y2 = float(input())

# Вычисление евклидова расстояния по формуле
# (x1 - x2)**2 — это возведение разности в квадрат
distance = math.sqrt((x1 - x2)**2 + (y1 - y2)**2)

# Вывод одного числа — евклидова расстояния
print(distance)
