# Ввод данных: количество школьников (n) и количество мандаринов (k), каждое на отдельной строке
n = int(input())
k = int(input())

# Вычисление количества мандаринов, которое достанется каждому школьнику (целочисленное деление)
per_student = k // n

# Вычисление количества мандаринов, которое останется в корзине (остаток от деления)
in_basket = k % n

# Вывод результатов, каждого числа на отдельной строке
print(per_student)
print(in_basket)
