shopping_list = ["молоко", "хлеб", "яблоки", "хлеб"]  # Добавим "хлеб" дважды для демонстрации

# 2. Добавляем ещё один продукт в конец списка с помощью метода append()
shopping_list.append("сыр")

# 3. Выводим список на экран
print("3. Список покупок (shopping_list):")
print(shopping_list)
print("-" * 50)

# 4. Создаем множество unique_items, содержащее те же продукты, и выводим его
unique_items = set(shopping_list)
print("4. Множество уникальных продуктов (unique_items):")
print(unique_items)
print("-" * 50)

# 5. Объяснение результатов
print("5. Объяснение:")
print("Множество (set) отличается от списка (list) двумя ключевыми свойствами:")
print("1. Отсутствие дубликатов. В отличие от списка, множество хранит только уникальные элементы.")
print("   Поэтому дублирующийся продукт ('xлеб') остался во множестве в единственном экземпляре.")
print("2. Неупорядоченность. Элементы множества не имеют фиксированного индекса и порядка, ")
print("   поэтому при выводе они могут располагаться в произвольной последовательности.")
