try:
    # 1. Запрашиваем у пользователя два числа (по умолчанию input() считывает строки)
    input_str1 = input("Введите первое целое число (num1): ")
    input_str2 = input("Введите второе целое число (num2): ")

    # 2. Преобразуем полученные строки в целые числа (int)
    # Если здесь будут введены буквы или дробные числа, Python вызовет ошибку ValueError
    num1 = int(input_str1)
    num2 = int(input_str2)

    # 3. Выполняем сложение этих чисел
    result = num1 + num2

    # Выводим результат на экран
    print(f"Результат сложения: {result}")

except ValueError:
    # 5* и 6*. Обработка ошибки некорректного ввода
    print("\n[Ошибка ValueError] Вы ввели некорректные данные!")
    print("Функция int() может преобразовать в целое число только строки, ")
    print("состоящие исключительно из цифр (например, '5' или '10'). ")
    print("Текст вроде 'abc' или дробные числа вроде '5.5' вызывают ошибку.")
