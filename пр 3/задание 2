# Создаем список
my_list = [1, 2, 3]
print("1. Исходный список:", my_list)

# Пробуем изменить первый элемент списка
my_list[0] = 100
print("1. Список после изменения:", my_list)
print("Объяснение: Списки (list) являются ИЗМЕНЯЕМЫМИ (mutable) объектами. ")
print("Мы можем свободно менять их элементы по индексам.\n")

# Создаем кортеж
my_tuple = (1, 2, 3)
print("2. Исходный кортеж:", my_tuple)

# Пробуем изменить первый элемент кортежа
try:
    my_tuple[0] = 100
except TypeError as error:
    print("Произошла ошибка:", error)
    print("Объяснение: Кортежи (tuple) являются НЕИЗМЕНЯЕМЫМИ (immutable) объектами. ")
    print("Python запрещает модифицировать их элементы после создания и вызывает TypeError.\n")

# Создаем строку
my_string = "cat"
print("3. Исходная строка:", my_string)

# Пробуем изменить первый символ строки
try:
    my_string[0] = 'b'
except TypeError as error:
    print("Произошла ошибка:", error)
    print("Объяснение: Строки (str) в Python также являются НЕИЗМЕНЯЕМЫМИ (immutable). ")
    print("Нельзя заменить символ внутри строки по индексу. Чтобы получить 'bat', ")
    print("нужно создать совершенно новую строку, например: 'b' + my_string[1:]\n")
